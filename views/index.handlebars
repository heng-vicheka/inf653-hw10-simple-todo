<main class="wrap">
  <h1>Simple Todo App</h1>
  <p class="subtitle">Stay organized with us today.</p>

  <form action="/todos" method="POST" class="add-form">
    <input class="text-input grow" name="text" placeholder="Add a todo..." required />
    <button class="btn btn-accent" type="submit">Add</button>
  </form>

  <ul class="todo-list">
    {{#each todos}}
      <li class="todo-item {{#if completed}}done{{/if}}">
        <form action="/todos/{{id}}/toggle" method="POST" class="inline">
          <input type="hidden" name="completed" value="{{completed}}" />
          <button class="btn btn-soft" type="submit">{{#if completed}}Undo{{else}}Done{{/if}}</button>
        </form>

        <form action="/todos/{{id}}/update" method="POST" class="inline grow">
          <input class="text-input grow" name="text" value="{{text}}" />
          <button class="btn btn-accent" type="submit">Update</button>
        </form>

        <form action="/todos/{{id}}/delete" method="POST" class="inline">
          <button class="btn btn-danger" type="submit">Delete</button>
        </form>
      </li>
    {{/each}}
  </ul>
</main>
